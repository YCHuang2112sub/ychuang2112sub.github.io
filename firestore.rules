rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner() { return request.auth != null && request.auth.uid == 'REPLACE_WITH_YOUR_FIREBASE_UID'; }
  // A successful server read confirms owner access; no document needs to exist.
  match /blogAccess/owner {
   allow get: if owner();
   allow list, write: if false;
  }
  match /blogTopics/{topicId} {
   allow read: if true;
   allow create, update: if owner()
    && request.resource.data.keys().hasOnly(['name'])
    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.name.size() <= 100;
   allow delete: if owner();
  }
  match /blogPosts/{postId} {
   allow read: if owner() || resource.data.published == true;
   allow create, update: if owner()
    && request.resource.data.keys().hasOnly(['title','topic','date','blocks','published','updatedAt'])
    && request.resource.data.title is string
    && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 300
    && request.resource.data.topic is string && request.resource.data.topic.size() <= 100
    && request.resource.data.date is string
    && request.resource.data.blocks is list
    && request.resource.data.published is bool
    && request.resource.data.updatedAt is string;
   allow delete: if owner();
  }
 }
}
